<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 无障碍服务引导卡片（未开启时显示） -->
    <LinearLayout
        android:id="@+id/cardAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFF3E0"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ 需要开启无障碍服务"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#E65100" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="长截图需要模拟滑动手势，这是 Android 系统对普通应用的唯一授权方式。\n\n本服务仅用于注入滑动手势，不监听您的任何输入内容和隐私数据。"
            android:textSize="14sp"
            android:textColor="#5D4037"
            android:lineSpacingMultiplier="1.4"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="开启步骤："
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#5D4037"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="1. 点击下方按钮，跳转到系统无障碍设置\n2. 找到「LongScreenshot」\n3. 点击开启 → 确认允许\n4. 返回本应用即可使用"
            android:textSize="13sp"
            android:textColor="#5D4037"
            android:lineSpacingMultiplier="1.5"/>

        <Button
            android:id="@+id/btnGoAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="前往开启无障碍服务"
            android:backgroundTint="#FF6D00"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <!-- 当前方案状态栏 -->
    <TextView
        android:id="@+id/tvStrategy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textSize="13sp"
        android:textColor="#666666"
        android:text="检测方案中..." />

    <!-- 操作按钮行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="开始截图"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="停止"
            android:layout_marginStart="4dp"/>

    </LinearLayout>

    <!-- 预览区域 -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:background="#F5F5F5" />

</LinearLayout>
